{
  "name": "honojs-plugins",
  "version": "0.0.0",
  "description": "A collection of plugins for HonoJS",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:pkg": "tsdown --workspace $INIT_CWD",
    "publish": "pnpm publish:npm",
    "publish:npm": "pnpm -r publish --no-git-checks && changeset tag",
    "version": "pnpm version:npm",
    "version:npm": "changeset version",
    "typecheck": "tsc --build",
    "typecheck:clean": "tsc --build --clean",
    "typecheck:watch": "tsc --build --watch",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "format": "prettier --check . --cache --cache-location .cache/.prettiercache",
    "format:fix": "prettier --write . --cache --cache-location .cache/.prettiercache"
  },
  "keywords": [],
  "author": "masb0ymas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masb0ymas/honojs-plugins.git"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "publint": "^0.3.21",
    "tsdown": "^0.22.9",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
